# ---------------------------------------------------------------------------
# Next.js side (.env.local) — generated by `npx convex dev`; no manual edits.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Convex deployment side — set with `npx convex env set NAME value`
# (or in the Convex dashboard). These are read INSIDE Convex functions and are
# NOT read from this file.
# ---------------------------------------------------------------------------

# Convex Auth v2 signing keys. Generated and set for you by running
#   npx @convex-dev/auth
# once per deployment (add --force to rotate). Never paste them here.
#   AUTH_PRIVATE_KEY   base64 PKCS8 RS256 private key
#   AUTH_JWKS          JSON Web Key Set served at /auth/.well-known/jwks.json

# Optional — booking confirmation / cancellation emails via Resend.
# Without RESEND_API_KEY no email is sent (the sandbox sets none).
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=bookings@example.com
#   NEXT_PUBLIC_APP_URL=https://convexbooking.dev   (base URL for manage links)
